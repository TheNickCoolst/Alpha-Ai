GROQ_API_KEY: gsk_YOUR_API_KEY_HERE
history_file: chat_history.json
model: "llama-3.3-70b-versatile"

# Maximum number of messages to keep in chat history
# This prevents memory issues during long conversations
# Older messages will be automatically trimmed
max_history_messages: 50

presets:
  default:
    system_prompt: |
      You are Alpha, an intelligent and helpful AI assistant.
      You are knowledgeable, conversational, and engaging.
      You provide clear and thoughtful responses.
      Keep your responses concise and natural for voice conversation.

sovits_ping_config:
  text_lang: en
  prompt_lang: en
  ref_audio_path: character_files/main_sample.wav
  prompt_text: This is a sample voice for you to get started with.
